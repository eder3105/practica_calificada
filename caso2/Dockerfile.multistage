# Etapa 1: Constructor para compilar e instalar dependencias de Python
FROM python:3.11-slim AS builder
WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir --prefix=/install -r requirements.txt

# Etapa 2: Imagen final ligera con Chromium y el entorno limpio
FROM python:3.11-slim
RUN apt-get update && apt-get install -y --no-install-recommends chromium chromium-driver && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY --from=builder /install /usr/local
COPY app.py .

CMD ["python", "app.py"]